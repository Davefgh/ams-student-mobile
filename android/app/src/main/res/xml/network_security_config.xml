<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic for localhost and network IPs during development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.254.106</domain>
        <domain includeSubdomains="true">192.168.254.132</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
    
    <!-- Trust all certificates for development (allows self-signed certificates) -->
    <!-- WARNING: Only use this in development! Remove for production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system certificates -->
            <certificates src="system" />
            <!-- Trust user certificates (allows self-signed certs) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

